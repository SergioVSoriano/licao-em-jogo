{
  "rules": {
    "rooms": {
      "$pin": {
        ".read": false,
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid)"
        },
        "public": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($pin).child('meta/hostUid').val() === auth.uid"
        },
        "snapshot": {
          ".read": "auth != null && root.child('rooms').child($pin).child('meta/hostUid').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($pin).child('meta/hostUid').val() === auth.uid"
        },
        "private": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && root.child('rooms').child($pin).child('meta/hostUid').val() === auth.uid"
          }
        },
        "inputs": {
          ".read": "auth != null && root.child('rooms').child($pin).child('meta/hostUid').val() === auth.uid",
          "$id": {
            ".write": "auth != null && (newData.child('pid').val() === auth.uid || root.child('rooms').child($pin).child('meta/hostUid').val() === auth.uid)"
          }
        },
        "presence": {
          ".read": "auth != null && root.child('rooms').child($pin).child('meta/hostUid').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    }
  }
}
