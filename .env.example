# Copie para .env.local e preencha com os dados do seu projeto Firebase
# (Console Firebase > Configurações do projeto > Seus apps > App da Web)
# Sem estas variáveis, o jogo roda em "modo demonstração" (só abas do mesmo navegador).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
